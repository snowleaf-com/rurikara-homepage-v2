    "@tailwindcss/cli": "^4.1.18",
    "clean-css": "^5.3.3",
    "clean-css-cli": "^5.6.3",
    "tailwindcss": "^4.1.18",
    "terser": "^5.49.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.26.0"
  }
